{
  "$schema": "https://cyclonedx.org/schema/bom-1.5.schema.json",
  "bomFormat": "CycloneDX",
  "specVersion": "1.5",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "name": "token-diet",
      "version": "1.11.4",
      "description": "AI token optimization stack: Serena + ICM + Context7"
    },
    "timestamp": "2026-07-10T00:00:00Z",
    "tools": [
      { "name": "cargo-cyclonedx", "version": "latest" },
      { "name": "pip-audit", "version": "latest" }
    ]
  },
  "components": [
    {
      "type": "application",
      "name": "serena",
      "version": "1.5.3",
      "purl": "pkg:pypi/serena@1.5.3",
      "description": "IDE-like symbol navigation via LSP",
      "licenses": [{ "license": { "id": "MIT" } }],
      "externalReferences": [
        { "type": "vcs", "url": "https://github.com/oraios/serena" }
      ]
    },
    {
      "type": "application",
      "name": "icm",
      "version": "0.10.57",
      "purl": "pkg:cargo/icm@0.10.57",
      "description": "Infinite Context Memory — cross-tool persistent-memory MCP server",
      "licenses": [{ "license": { "id": "Apache-2.0" } }],
      "externalReferences": [
        { "type": "vcs", "url": "https://github.com/artificemachine/icm" }
      ]
    }
  ],
  "services": [
    {
      "bom-ref": "context7",
      "name": "context7",
      "description": "Remote MCP service serving up-to-date library documentation. Registered by the installer; no Context7 code is bundled or vendored.",
      "endpoints": ["https://mcp.context7.com/mcp"],
      "authenticated": false,
      "x-trust-boundary": true,
      "properties": [
        { "name": "optional-auth", "value": "CONTEXT7_API_KEY, appended to the URL by the installer, never logged" }
      ]
    }
  ]
}
