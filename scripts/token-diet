#!/usr/bin/env bash
# token-diet — token optimization stack dashboard
# Shows component status and health across Serena + ICM + context7.
#
# Usage:
#   token-diet status         Show component status dashboard (default)
#   token-diet health         Quick health check: components + MCP hosts
#   token-diet version        Show versions of the installed components
#   token-diet verify         Re-run installation verification
#   token-diet uninstall      Remove all token-diet components
#   token-diet --help         Show this help

set -euo pipefail

readonly TD_VERSION="2.0.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Colors -------------------------------------------------------------------
if [ -t 1 ]; then
  GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'
  BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
else
  GREEN=''; YELLOW=''; RED=''; BOLD=''; DIM=''; NC=''
fi

ok()   { echo -e "  ${GREEN}✓${NC}  $*"; }
warn() { echo -e "  ${YELLOW}!${NC}  $*"; }
miss() { echo -e "  ${RED}✗${NC}  $*"; }
dim()  { echo -e "${DIM}$*${NC}"; }

# --- Helpers ------------------------------------------------------------------
human_tokens() {
  local n=$1
  if   [ "$n" -ge 1000000 ]; then printf "%.1fM" "$(echo "$n / 1000000" | bc -l)"
  elif [ "$n" -ge 1000 ];    then printf "%.1fK" "$(echo "$n / 1000"    | bc -l)"
  else printf "%d" "$n"
  fi
}

check_cmd() { command -v "$1" &>/dev/null; }

# Extract the configured command for [mcp_servers.<tool>] from Codex TOML.
codex_mcp_command() {
  local tool="$1"
  local codex="$HOME/.codex/config.toml"
  check_cmd python3 || return 1
  [ -f "$codex" ] || return 1

  python3 - "$codex" "$tool" << 'PY'
import pathlib, re, sys

cfg_path = pathlib.Path(sys.argv[1])
tool = sys.argv[2]
text = cfg_path.read_text()
block = re.search(r'(?ms)^\[mcp_servers\.%s\]\s*(.*?)(?=^\[|\Z)' % re.escape(tool), text)
if not block:
    raise SystemExit(1)
command = re.search(r'(?m)^command\s*=\s*["\']([^"\']+)["\']\s*$', block.group(1))
if not command:
    raise SystemExit(1)
print(command.group(1))
PY
}

mcp_command_exists() {
  local command_value="$1"
  if [[ "$command_value" == */* ]]; then
    [ -x "$command_value" ]
  else
    check_cmd "$command_value"
  fi
}

# Read minimum required version for a tool from config/compat.json.
# Outputs "0.0.0" if the file is absent or the tool is not listed.
_compat_min() {
  local tool="$1"
  local compat_file="$SCRIPT_DIR/../config/compat.json"
  if [ ! -f "$compat_file" ]; then echo "0.0.0"; return; fi
  python3 -c "
import json, sys
try:
    d = json.load(open('$compat_file'))
    print(d['tools']['$tool']['min'])
except Exception:
    print('0.0.0')
" 2>/dev/null || echo "0.0.0"
}

# Return 0 (true) when \$installed >= \$min_required (semver comparison).
# Pre-release suffixes like -mock, -beta are stripped before comparison.
_semver_ok() {
  local installed="$1" min="$2"
  python3 - "$installed" "$min" << 'PY'
import sys, re
def parse(v):
    v = re.sub(r'[^0-9.].*$', '', v)   # strip -mock, -beta, -rc1, etc.
    parts = v.split('.')
    try:
        return tuple(int(x) for x in (parts + ['0', '0', '0'])[:3])
    except ValueError:
        return (0, 0, 0)
try:
    sys.exit(0 if parse(sys.argv[1]) >= parse(sys.argv[2]) else 1)
except Exception:
    sys.exit(0)   # unparseable → assume OK
PY
}

codex_mcp_command_issue() {
  local tool="$1"
  local command_value
  command_value="$(codex_mcp_command "$tool")" || return 0
  if ! mcp_command_exists "$command_value"; then
    echo "Codex ${tool} MCP command missing: ${command_value}"
  fi
  return 0
}

# Scan common MCP config files for a tool name
hosts_registered() {
  local tool="$1"
  local found=()

  # Canonical MCP-host registry (config/hosts-mcp.json) is the single source of
  # truth for which JSON home-config files to scan and the MCP key dialect. This
  # replaces a hardcoded config-path list + inline dialect that had drifted from
  # the registry. Resolve it exactly like _compat_min resolves compat.json:
  # installed SCRIPT_DIR is ~/.local/bin, so ../config -> ~/.local/config, where
  # install.sh ships hosts-mcp.json; a repo checkout resolves ../config ->
  # repo/config. When the registry is unreadable the helper falls back to the
  # historical hardcoded path list, so detection keeps working (Strict
  # Installation Decoupling + defense in depth).
  local registry="$SCRIPT_DIR/../config/hosts-mcp.json"

  # JSON home-config scan (claude-code / claude-desktop / opencode). Codex, VS
  # Code and Gemini keep their own matchers below, unchanged. The helper prints
  # one host per matching file (opencode may appear twice; de-duped just below).
  local _hline
  while IFS= read -r _hline; do
    [ -n "$_hline" ] && found+=("$_hline")
  done < <(python3 - "$registry" "$HOME" "$tool" 2>/dev/null << 'PY'
import json, os, sys
registry, home, tool = sys.argv[1], sys.argv[2], sys.argv[3]
tool_l = tool.lower()

# Ordered relative paths of JSON home-config files to scan. Primary source: the
# canonical registry. Fallback (registry missing/malformed): the historical
# hardcoded list, so host detection still works decoupled from the registry.
dialect = ["mcpServers", "mcp", "servers"]
paths = None
try:
    with open(registry, encoding="utf-8") as f:
        reg = json.load(f)
    dialect = reg.get("mcp_key_dialect", dialect)
    paths = []
    for e in reg.get("home_configs", []):
        if e.get("format") != "json":
            continue
        # Gemini and VS Code have their own dedicated matchers below (gemini reads
        # its config directly; vscode greps ~/.config/Code/User/settings.json).
        # Both are attribute()d by path substring here, and VS Code's settings.json
        # would be mis-attributed to claude-code — so skip them in the JSON scan,
        # exactly as the registry _comment documents.
        if e.get("host") in ("gemini", "vscode"):
            continue
        p = e.get("path")
        if p:
            paths.append(p)
    # XDG OpenCode path. The registry now records it (completeness invariant), but
    # append defensively if a stale/partial registry omits it, de-duping so it is
    # never scanned twice.
    if ".config/opencode/opencode.json" not in paths:
        paths.append(".config/opencode/opencode.json")
except Exception:
    paths = [
        ".claude.json",
        ".claude/settings.json",
        "Library/Application Support/Claude/claude_desktop_config.json",
        ".config/Claude/claude_desktop_config.json",
        ".opencode.json",
        ".config/opencode/opencode.json",
    ]

def attribute(rel):
    # Verbatim port of the previous bash `case "$cfg"` substring logic. Ordering
    # matters and its quirks are preserved: the Linux claude-desktop path
    # (.config/Claude/claude_desktop_config.json) matches no arm -> no host.
    if "Application Support" in rel:
        return "claude-desktop"
    if ".claude.json" in rel:
        return "claude-code"
    if "settings.json" in rel:
        return "claude-code"
    if "opencode" in rel:
        return "opencode"
    return None

for rel in paths:
    path = os.path.join(home, rel)
    if not os.path.isfile(path):
        continue
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except Exception:
        continue
    # Merge all dialect keys (mcpServers, mcp, servers). A config may carry both
    # mcpServers and mcp (e.g. opencode) — merge, do not first-truthy, so neither
    # is dropped. Substring key match (my-serena-wrapper matches tool "serena").
    servers = {}
    for key in dialect:
        v = d.get(key)
        if isinstance(v, dict):
            servers.update(v)
    if any(tool_l in k.lower() for k in servers):
        host = attribute(rel)
        if host:
            print(host)
PY
)

  # OpenCode: check both legacy (~/.opencode.json) and XDG path together.
  # Either file registering the tool counts as "opencode" registered.
  # (Already handled above via the configs array; dedup if both matched.)
  # Remove duplicate "opencode" entries from found.
  local deduped=()
  local seen_opencode=false
  for h in "${found[@]}"; do
    if [ "$h" = "opencode" ]; then
      $seen_opencode && continue
      seen_opencode=true
    fi
    deduped+=("$h")
  done
  found=("${deduped[@]}")
  # Codex
  codex_mcp_command "$tool" >/dev/null 2>&1 && found+=("codex")
  # VS Code
  local vscode_cfg="$HOME/.config/Code/User/settings.json"
  [ -f "$vscode_cfg" ] && grep -q "$tool" "$vscode_cfg" 2>/dev/null && found+=("vscode")
  # Gemini CLI — read config file directly (gemini mcp list probes connections and blocks)
  local _gem_cfg="$HOME/.gemini/settings.json"
  if [ -f "$_gem_cfg" ]; then
    python3 - "$_gem_cfg" "$tool" << 'PY' 2>/dev/null
import json,sys
d=json.load(open(sys.argv[1]))
servers={**d.get('mcpServers',{}),**d.get('mcp',{})}
sys.exit(0 if any(sys.argv[2] in k.lower() for k in servers.keys()) else 1)
PY
    [ $? -eq 0 ] && found+=("gemini")
  fi

  if [ ${#found[@]} -gt 0 ]; then
    echo "${found[*]}" | tr ' ' ','
  else
    echo "none"
  fi
}

# --- Commands -----------------------------------------------------------------
# Note: tracked token-savings metrics were removed together with RTK (independent benchmarks found rtk gain did not reflect real cost); context7, Serena and ICM have no per-command counter, so this view reports presence and health, not spend.
cmd_status() {
  local components_active=0

  echo -e "\n${BOLD}token-diet${NC} ${DIM}— component status${NC}\n"

  # --- Serena ----------------------------------------------------------------
  echo -e "${BOLD}Serena${NC} ${DIM}— LSP symbol navigation${NC}"
  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
  echo -e "  ${DIM}Note: Serena reduces prompt size — not tracked per-command${NC}"

  local mode; mode=$(_serena_runtime_mode)

  if [ "$mode" != "none" ]; then
    components_active=$((components_active + 1))
    local sh; sh=$(hosts_registered "serena")
    local mem_count=0
    [ -d "$HOME/.serena/memories" ] && mem_count=$(ls "$HOME/.serena/memories/" 2>/dev/null | wc -l | tr -d ' ')

    printf "  %-22s %s\n" "Runtime:"   "$mode"
    printf "  %-22s %s\n" "MCP hosts:" "$sh"
    printf "  %-22s %s\n" "Memories:"  "$mem_count"
    ok "Serena — active"
  else
    miss "Serena not installed  →  run: bash install.sh --serena-only"
  fi

  echo ""

  # --- ICM -------------------------------------------------------------------
  echo -e "${BOLD}ICM${NC} ${DIM}— persistent cross-tool memory${NC}"
  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
  echo -e "  ${DIM}Note: ICM cuts re-explanation cost — recall replaces re-reading${NC}"

  if check_cmd icm; then
    components_active=$((components_active + 1))
    local iv; iv=$(icm --version 2>/dev/null | awk '{print $2}')
    local ih; ih=$(hosts_registered "icm")
    printf "  %-22s %s\n" "Version:"   "$iv"
    printf "  %-22s %s\n" "MCP hosts:" "$ih"
    ok "ICM ${iv} — active"
  else
    miss "ICM not installed  →  run: bash install.sh --icm-only"
  fi

  echo ""

  # --- context7 --------------------------------------------------------------
  echo -e "${BOLD}context7${NC} ${DIM}— remote library-docs MCP${NC}"
  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
  echo -e "  ${DIM}Note: CONTEXT7_API_KEY is appended to the URL at registration${NC}"
  echo -e "  ${DIM}time by the installer — the key is never echoed or displayed${NC}"

  local c7_hosts; c7_hosts=$(hosts_registered "context7")
  if [ "$c7_hosts" != "none" ]; then
    components_active=$((components_active + 1))
    printf "  %-22s %s\n" "Transport:" "remote HTTP"
    printf "  %-22s %s\n" "Endpoint:"  "https://mcp.context7.com/mcp"
    printf "  %-22s %s\n" "MCP hosts:" "$c7_hosts"
    ok "context7 — active"
  else
    miss "context7 not registered  →  register via install.sh (optional CONTEXT7_API_KEY)"
  fi

  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
  echo -e "  ${DIM}Serena, ICM and context7 savings are structural (smaller prompts,${NC}"
  echo -e "  ${DIM}fewer turns, fresher docs) and not individually tracked${NC}"

  echo ""
  if [ "$components_active" -eq 3 ]; then
    echo -e "  ${GREEN}${BOLD}Full stack active.${NC}"
  elif [ "$components_active" -gt 0 ]; then
    echo -e "  ${YELLOW}${BOLD}Partial stack — run 'bash install.sh' to complete setup.${NC}"
  else
    echo -e "  ${RED}${BOLD}No components installed — run 'bash install.sh' to get started.${NC}"
  fi
  echo ""
}

cmd_version() {
  echo -e "\n${BOLD}token-diet component versions${NC}\n"

  local mode; mode=$(_serena_runtime_mode)
  if [ "$mode" != "none" ]; then
    ok "Serena runtime: $mode"
  else
    miss "Serena runtime not found"
  fi

  if check_cmd icm; then
    local icm_ver; icm_ver=$(icm --version 2>/dev/null | awk '{print $2}')
    local icm_min; icm_min=$(_compat_min "icm")
    if _semver_ok "$icm_ver" "$icm_min"; then
      ok "ICM     icm ${icm_ver}  (compat: OK)"
    else
      warn "ICM     icm ${icm_ver}  (compat: WARN — below min ${icm_min}, upgrade ICM)"
    fi
  else
    miss "ICM     not installed"
  fi

  local c7_hosts; c7_hosts=$(hosts_registered "context7")
  if [ "$c7_hosts" != "none" ]; then
    ok "context7  remote (registered in: ${c7_hosts})"
  else
    miss "context7  not registered in any MCP host"
  fi
  echo ""
}
cmd_dashboard() {
  local dashboard_bin
  # Prefer the installed copy, fall back to script-dir sibling
  if command -v token-diet-dashboard &>/dev/null; then
    dashboard_bin="$(command -v token-diet-dashboard)"
  else
    dashboard_bin="$SCRIPT_DIR/token-diet-dashboard"
  fi
  if [ ! -f "$dashboard_bin" ]; then
    echo "token-diet-dashboard not found — run: bash install.sh" >&2; exit 1
  fi
  exec python3 "$dashboard_bin" "$@"
}

cmd_health() {
  local issues=0
  echo -e "\n${BOLD}token-diet health${NC}\n"

  # Serena
  if check_cmd uvx || docker image inspect token-diet/serena:latest &>/dev/null 2>&1; then
    local serena_hosts; serena_hosts=$(hosts_registered "serena")
    ok "Serena  (hosts: ${serena_hosts})"
  else
    miss "Serena not found  (uvx or Docker required)"
    issues=$(( issues + 1 ))
  fi

  local serena_codex_issue; serena_codex_issue=$(codex_mcp_command_issue "serena")
  if [ -n "$serena_codex_issue" ]; then
    warn "$serena_codex_issue"
    issues=$(( issues + 1 ))
  fi

  # ICM
  if check_cmd icm; then
    local icm_ver; icm_ver=$(icm --version 2>/dev/null | awk '{print $2}') || true
    local icm_hosts; icm_hosts=$(hosts_registered "icm")
    ok "ICM ${icm_ver}  (hosts: ${icm_hosts})"
    local icm_codex_issue; icm_codex_issue=$(codex_mcp_command_issue "icm")
    if [ -n "$icm_codex_issue" ]; then
      warn "$icm_codex_issue"
      issues=$(( issues + 1 ))
    fi
  else
    miss "ICM not found"
    issues=$(( issues + 1 ))
  fi

  # context7 — remote MCP server; healthy = registered in at least one host
  local c7_hosts; c7_hosts=$(hosts_registered "context7")
  if [ "$c7_hosts" != "none" ]; then
    ok "context7  (remote, hosts: ${c7_hosts})"
  else
    miss "context7 not registered in any MCP host"
    issues=$(( issues + 1 ))
  fi

  echo ""
  if [ "$issues" -eq 0 ]; then
    echo -e "  ${GREEN}${BOLD}All components healthy${NC}"
    echo ""
    return 0
  else
    echo -e "  ${YELLOW}${BOLD}${issues} issue(s) found — reinstall components or repair MCP registrations${NC}"
    echo ""
    return 1
  fi
}

cmd_uninstall() {
  local uninstall_sh="$SCRIPT_DIR/uninstall.sh"
  if [ ! -f "$uninstall_sh" ]; then
    # Fallback: look next to the install script
    uninstall_sh="$(dirname "$SCRIPT_DIR/token-diet-install.sh")/uninstall.sh"
  fi
  if [ ! -f "$uninstall_sh" ]; then
    echo "Error: uninstall.sh not found. Re-run the installer to restore it:" >&2
    echo "  bash \$(dirname \$(which token-diet))/token-diet-install.sh" >&2
    exit 1
  fi
  bash "$uninstall_sh" "$@"
}

# --- Update / Reinstall ------------------------------------------------------
# Resolve the install script. Order:
#   1. $TD_INSTALLER override
#   2. $SCRIPT_DIR/install.sh         (running from a repo checkout)
#   3. $SCRIPT_DIR/token-diet-install.sh (installed copy next to this binary)
#   4. Clone artificemachine/token-diet to a tempdir and use scripts/install.sh
# Echoes the path. Clone-tempdir paths are auto-cleaned by the trap registered
# inside cmd_update.
_resolve_installer() {
  local target="${1:-$HOME/.token-diet-clone}"  # unused; kept for trap symmetry
  if [ -n "${TD_INSTALLER:-}" ] && [ -f "$TD_INSTALLER" ]; then
    echo "$TD_INSTALLER"; return 0
  fi
  if [ -f "$SCRIPT_DIR/install.sh" ]; then
    echo "$SCRIPT_DIR/install.sh"; return 0
  fi
  if [ -f "$SCRIPT_DIR/token-diet-install.sh" ]; then
    echo "$SCRIPT_DIR/token-diet-install.sh"; return 0
  fi
  return 1
}

cmd_update() {
  local fresh=false
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --fresh) fresh=true ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  if $fresh; then
    echo "[token-diet update] --fresh requested; removing current install..."
    cmd_uninstall --force || true
    echo "[token-diet update] re-running installer..."
  fi

  local installer
  if installer="$(_resolve_installer)"; then
    echo "[token-diet update] using local installer: $installer"
    exec bash "$installer" "${args[@]}"
  fi

  command -v git >/dev/null 2>&1 || {
    echo "Error: git not found. Install git, or set TD_INSTALLER=/path/to/install.sh" >&2
    exit 1
  }

  local tmpdir
  tmpdir="$(mktemp -d -t token-diet-update.XXXXXX)"
  trap 'rm -rf "$tmpdir"' EXIT
  local repo="https://github.com/artificemachine/token-diet"
  echo "[token-diet update] no local checkout found; cloning $repo (depth 1)..."
  if ! git clone --depth 1 "$repo" "$tmpdir/repo" >/dev/null 2>&1; then
    echo "Error: failed to clone $repo" >&2
    exit 1
  fi

  # Show the commit we are about to run, so the user sees what they trust.
  ( cd "$tmpdir/repo" && git --no-pager log -1 --pretty='[token-diet update] running commit %h %s (%ci)' )

  bash "$tmpdir/repo/scripts/install.sh" "${args[@]}"
}

cmd_reinstall() {
  echo "Warning: 'reinstall' is deprecated. Use 'token-diet update --fresh' instead."
  cmd_update --fresh "$@"
}
# --- Service (always-on dashboard daemon) -------------------------------------
cmd_mcp() {
  local sub="${1:-help}"
  case "$sub" in
    install|register)
      shift
      cmd_update --serena-only "$@"
      ;;
                list|status)
      (cmd_doctor --json 2>/dev/null || true) | python3 -c 'import json, sys;
try:
    d=json.load(sys.stdin)
except Exception:
    d={}
s_hosts = d.get("serena_mcp", {}).get("registered_hosts", [])
i_hosts = d.get("icm_mcp", {}).get("registered_hosts", [])
c_hosts = d.get("context7_mcp", {}).get("registered_hosts", [])
all_hosts = sorted(list(set(list(s_hosts) + list(i_hosts) + list(c_hosts))))
print("Registered MCP Hosts:")
if not all_hosts: print("  (none)")
for h in all_hosts:
    st = []
    if h in s_hosts: st.append("serena")
    if h in i_hosts: st.append("icm")
    if h in c_hosts: st.append("context7")
    print("  ✓ %-16s (%s)" % (h, ", ".join(st)))'
      ;;
    *)
      echo "Usage: token-diet mcp [install|list]"
      echo ""
      echo "  install   Register token-diet MCP servers (Serena/ICM) in detected AI hosts"
      echo "  list      Show hosts where token-diet MCP is currently registered"
      exit 1
      ;;
  esac
}

cmd_upstream() {
  local sub="${1:-help}"
  local tool="${2:-}"
  local serena_url="https://github.com/artificemachine/serena.git"
  local icm_url="https://github.com/artificemachine/icm.git"

  # Fork maintenance only makes sense from a source checkout. Once token-diet is
  # installed to ~/.local/bin there is no ../forks, so refuse with a clear
  # message instead of emitting confusing per-tool git errors.
  local forks_dir="$SCRIPT_DIR/../forks"
  case "$sub" in
    setup|check|diff)
      if [ ! -d "$forks_dir" ]; then
        echo "Error: 'token-diet upstream' is a source-repo maintenance command."
        echo "No forks/ directory found at: $forks_dir"
        echo "Run it from a token-diet git checkout, not the installed binary."
        exit 1
      fi
      ;;
  esac

  case "$sub" in
    setup)
      echo "Configuring upstream remotes in forks/..."
      (cd "$forks_dir/serena" && git remote add upstream "$serena_url" 2>/dev/null || git remote set-url upstream "$serena_url" && echo "  ✓ serena")
      (cd "$forks_dir/icm" && git remote add upstream "$icm_url" 2>/dev/null || git remote set-url upstream "$icm_url" && echo "  ✓ icm")
      echo "Setup complete."
      ;;
    check)
      echo -e "Checking for new commits from original authors..."
      git submodule foreach -q '
        name=$(basename $displaypath)
        git fetch upstream main --quiet 2>/dev/null || git fetch upstream master --quiet 2>/dev/null
        new=$(git log --oneline HEAD..upstream/main 2>/dev/null || git log --oneline HEAD..upstream/master 2>/dev/null)
        if [ -n "$new" ]; then
          echo -e "\n[!] $name has new updates upstream:"
          echo "$new" | sed "s/^/  /"
        else
          echo -e "  ✓ $name is up to date."
        fi
      '
      echo -e "\nMaintenance Advice:"
      echo "1. Run '\''token-diet upstream diff <tool>'\'' to audit changes."
      echo "2. If safe, '\''cd forks/<tool> && git merge upstream/main'\''."
      echo "3. RE-VERIFY SECURITY PATCHES after any merge!"
      ;;
    diff)
      if [ -z "$tool" ]; then
        echo "Error: specify tool (serena|icm)"
        exit 1
      fi
      local dir="$forks_dir/$tool"
      if [ ! -d "$dir" ]; then echo "Error: tool dir not found: $dir"; exit 1; fi
      echo "Showing diff: fork vs original author ($tool)"
      (cd "$dir" && git fetch upstream main --quiet 2>/dev/null || git fetch upstream master --quiet 2>/dev/null)
      (
        cd "$dir" || exit 1
        if git rev-parse --verify --quiet upstream/main >/dev/null; then
          git diff HEAD..upstream/main
        else
          git diff HEAD..upstream/master
        fi
      )
      ;;
    *)
      echo "Usage: token-diet upstream [setup|check|diff]"
      echo ""
      echo "  setup      Configure '\''upstream'\'' remotes for all forks"
      echo "  check      Search for new commits in original repositories"
      echo "  diff <t>   Audit code differences for a specific tool"
      ;;
  esac
}
cmd_service() {
  local sub="${1:-help}"
  local log_dir="$HOME/.local/share/token-diet"
  local log_file="$log_dir/dashboard.log"
  local dashboard_bin
  dashboard_bin="$(command -v token-diet-dashboard 2>/dev/null || echo "$SCRIPT_DIR/token-diet-dashboard")"
  local py_bin
  py_bin="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || echo python3)"

  # ---- macOS launchd ---------------------------------------------------------
  _service_macos() {
    local plist="$HOME/Library/LaunchAgents/com.token-diet.dashboard.plist"
    case "$sub" in
      install)
        mkdir -p "$log_dir"
        mkdir -p "$(dirname "$plist")"
        # Resolve absolute python3 path (bypass pyenv shims which need shell init)
        local abs_py
        abs_py="$(python3 -c 'import sys; print(sys.executable)' 2>/dev/null || echo "$py_bin")"
        cat > "$plist" << PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.token-diet.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>${abs_py}</string>
        <string>${dashboard_bin}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${PATH}</string>
        <key>HOME</key>
        <string>${HOME}</string>
        <key>TOKEN_DIET_DASHBOARD_OPEN_BROWSER</key>
        <string>0</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${log_file}</string>
    <key>StandardErrorPath</key>
    <string>${log_file}</string>
</dict>
</plist>
PLIST
        launchctl bootout "gui/$(id -u)/com.token-diet.dashboard" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
        ok "Service installed and started (macOS launchd)"
        ok "Log: $log_file"
        ok "Dashboard: http://127.0.0.1:7384"
        ;;
      uninstall)
        launchctl bootout "gui/$(id -u)/com.token-diet.dashboard" 2>/dev/null || true
        rm -f "$plist"
        ok "Service removed (macOS launchd)"
        ;;
      start)
        launchctl kickstart -k "gui/$(id -u)/com.token-diet.dashboard" 2>/dev/null \
          || launchctl start com.token-diet.dashboard
        ok "Dashboard started"
        ;;
      stop)
        launchctl kill TERM "gui/$(id -u)/com.token-diet.dashboard" 2>/dev/null \
          || launchctl stop com.token-diet.dashboard
        ok "Dashboard stopped"
        ;;
      status)
        if launchctl print "gui/$(id -u)/com.token-diet.dashboard" &>/dev/null; then
          ok "Service registered (macOS launchd)"
          local pid
          pid=$(launchctl print "gui/$(id -u)/com.token-diet.dashboard" 2>/dev/null \
            | grep -E '^\s+pid\s*=' | awk '{print $3}' || true)
          [ -n "$pid" ] && ok "Running — PID $pid — http://127.0.0.1:7384" \
                        || warn "Registered but not running"
        else
          miss "Not installed — run: token-diet service install"
        fi
        ;;
      *)
        _service_usage ;;
    esac
  }

  # ---- Linux systemd (user) --------------------------------------------------
  _service_linux() {
    local unit_dir="$HOME/.config/systemd/user"
    local unit="$unit_dir/token-diet-dashboard.service"
    case "$sub" in
      install)
        mkdir -p "$unit_dir" "$log_dir"
        cat > "$unit" << UNIT
[Unit]
Description=token-diet browser dashboard
After=network.target

[Service]
ExecStart=${py_bin} ${dashboard_bin}
Environment=TOKEN_DIET_DASHBOARD_OPEN_BROWSER=0
Restart=always
RestartSec=5
StandardOutput=append:${log_file}
StandardError=append:${log_file}

[Install]
WantedBy=default.target
UNIT
        systemctl --user daemon-reload
        systemctl --user enable --now token-diet-dashboard
        ok "Service installed and started (systemd user)"
        ok "Log: $log_file"
        ok "Dashboard: http://127.0.0.1:7384"
        ;;
      uninstall)
        systemctl --user disable --now token-diet-dashboard 2>/dev/null || true
        rm -f "$unit"
        systemctl --user daemon-reload
        ok "Service removed (systemd user)"
        ;;
      start)
        systemctl --user start token-diet-dashboard
        ok "Dashboard started"
        ;;
      stop)
        systemctl --user stop token-diet-dashboard
        ok "Dashboard stopped"
        ;;
      status)
        systemctl --user status token-diet-dashboard
        ;;
      *)
        _service_usage ;;
    esac
  }

  _service_usage() {
    cat << EOF
Usage: token-diet service <subcommand>

  install     Register dashboard as a system service (starts on login, auto-restarts)
  uninstall   Remove the service registration
  start       Start the dashboard service
  stop        Stop the dashboard service
  status      Show service status

Platforms:
  macOS   — launchd  (~/.local/share/token-diet/dashboard.log)
  Linux   — systemd user service
  Windows — use: token-diet.ps1 service install
EOF
    return 1
  }

  local os
  os="$(uname -s)"
  case "$os" in
    Darwin) _service_macos ;;
    Linux)  _service_linux ;;
    *)
      warn "Unsupported platform: $os"
      warn "On Windows use: token-diet.ps1 service install"
      exit 1
      ;;
  esac
}

# Walk up from cwd toward $HOME looking for .token-budget. Echoes path if found.
find_budget_file() {
  local dir="$PWD"
  while [[ "$dir" == "$HOME"* ]]; do
    [ -f "$dir/.token-budget" ] && echo "$dir/.token-budget" && return 0
    [ "$dir" = "$HOME" ] && break
    dir="$(dirname "$dir")"
  done
  return 1
}

# Ensure ~/.token-budget exists (auto-create with defaults if missing).
# Echoes the path to the global budget file.
ensure_global_budget() {
  local global="$HOME/.token-budget"
  if [ ! -f "$global" ]; then
    python3 - "$global" << 'PY'
import json, os, sys, pathlib, datetime, tempfile
def atomic_write(path, text):
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".td-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError:
            pass
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
p = pathlib.Path(sys.argv[1])
atomic_write(str(p), json.dumps({
    "warn": 1500000, "hard": 0,
    "installed_at": datetime.date.today().isoformat(),
    "baseline_tokens": 0,
}, indent=2) + "\n")
PY
  fi
  echo "$global"
}

cmd_budget() {
  local subcmd="${1:-status}"
  shift || true

  case "$subcmd" in
    init)
      local is_global=false
      [ "${1:-}" = "--global" ] && is_global=true
      local target
      if $is_global; then target="$HOME/.token-budget"; else target="$PWD/.token-budget"; fi
      if [ -f "$target" ]; then
        warn ".token-budget already exists at $target"
        return 0
      fi
      local _baseline=0
      TD_LIB_DIR="$SCRIPT_DIR/lib" python3 - "$target" "$_baseline" << 'PY'
import datetime, os, sys
sys.path.insert(0, os.environ["TD_LIB_DIR"])
import tdconfig

d = {"warn": 1500000, "hard": 0,
     "installed_at": datetime.date.today().isoformat(),
     "baseline_tokens": int(sys.argv[2])}
# Caller already returned early if the file exists, so nothing is overwritten
# here; atomic_write_json avoids leaving a half-written budget file on a crash.
tdconfig.atomic_write_json(sys.argv[1], d)
PY
      if $is_global; then
        ok "Created global $target  (warn: 1.5M, hard: unlimited)"
      else
        ok "Created $target  (warn: 1.5M, hard: unlimited)"
      fi
      local gitignore="$PWD/.gitignore"
      if [ -f "$gitignore" ]; then
        if ! grep -qxF '.token-budget' "$gitignore"; then
          printf '\n.token-budget\n' >> "$gitignore"
          ok "Added .token-budget to .gitignore"
        fi
      elif git rev-parse --git-dir &>/dev/null 2>&1; then
        printf '.token-budget\n' > "$gitignore"
        ok "Created .gitignore with .token-budget"
      fi
      ;;

    hubs)
      local cfg_dir="$HOME/.config/token-diet"
      local cfg_file="$cfg_dir/config.json"
      mkdir -p "$cfg_dir"
      if [[ "${1:-}" == "add" && -n "${2:-}" ]]; then
        local new_hub="$2"
        # Convert to relative to home if possible
        new_hub="${new_hub/#$HOME/~}"
        python3 - "$cfg_file" "$new_hub" << 'PY'
import json, os, sys, pathlib, tempfile
def atomic_write(path, text):
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".td-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError:
            pass
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
path = pathlib.Path(sys.argv[1])
new_h = sys.argv[2]
try: data = json.loads(path.read_text())
except: data = {}
hubs = data.get("project_hubs", [])
if new_h not in hubs:
    hubs.append(new_h)
    data["project_hubs"] = hubs
    atomic_write(str(path), json.dumps(data, indent=2))
    print(f"Added hub: {new_h}")
else:
    print(f"Hub already exists: {new_h}")
PY
      elif [[ "${1:-}" == "list" || -z "${1:-}" ]]; then
        echo -e "\n  ${BOLD}Project Hubs${NC} (scanned for budgets)"
        echo -e "  ${DIM}$(printf '%.0s─' {1..40})${NC}"
        python3 - "$cfg_file" << 'PY'
import json, sys, pathlib
path = pathlib.Path(sys.argv[1])
try:
    hubs = json.loads(path.read_text()).get("project_hubs", [])
    for h in hubs: print(f"    {h}")
    if not hubs: print("    (no hubs configured)")
except: print("    (no hubs configured)")
PY
        echo -e "\n  Run: ${BOLD}token-diet budget hubs add ~/Projects${NC}\n"
      else
        echo "Usage: token-diet budget hubs <list|add <path>>" >&2
      fi
      ;;

    status)
      local budget_file global_file="$HOME/.token-budget"
      budget_file=$(find_budget_file) || budget_file=$(ensure_global_budget)

      # Detect if active file is a project override (not the global itself)
      local is_override=false
      if [ "$budget_file" != "$global_file" ]; then
        is_override=true
      fi

      _print_budget_section() {
        local file="$1" label="$2"
        local warn_t hard_t baseline
        read -r warn_t hard_t baseline <<< "$(python3 -c "
import json; d=json.load(open('$file'))
print(d.get('warn',1500000), d.get('hard',0), d.get('baseline_tokens',0))" 2>/dev/null)" \
          || { warn_t=1500000; hard_t=0; baseline=0; }
        # No usage counter is installed anymore (the tracked counter went away
        # with the deprecated command wrapper; context7/Serena/ICM savings are
        # structural and were never per-command countable). Budget status is
        # therefore threshold-display only: no burn-down, no hard-stop math.
        local used=0

        local unlimited=false
        [ "$hard_t" -eq 0 ] && unlimited=true
        local remaining pct=0
        if $unlimited; then remaining="unlimited"
        else
          remaining=$(( hard_t - used ))
        fi

        echo -e "\n${BOLD}token-diet budget${NC}  ${DIM}${label}${NC}  ${DIM}($file)${NC}\n"
        printf "  %-20s %s\n" "Used:"      "untracked (no usage counter installed)"
        printf "  %-20s %s\n" "Warn at:"   "$(human_tokens "$warn_t")"
        printf "  %-20s %s\n" "Hard stop:" "$(if $unlimited; then echo 'unlimited'; else human_tokens "$hard_t"; fi)"
        printf "  %-20s %s\n" "Remaining:" "$(if $unlimited; then echo 'unlimited'; else human_tokens "$remaining"; fi)"
        echo ""

        if ! $unlimited && [ "$used" -ge "$hard_t" ]; then
          echo -e "  ${RED}${BOLD}HARD STOP — budget exhausted (${pct}%)${NC}\n"; return 3
        elif [ "$used" -ge "$warn_t" ]; then
          echo -e "  ${YELLOW}${BOLD}WARN — approaching warn threshold (${pct}%)${NC}\n"; return 2
        else
          echo -e "  ${GREEN}${BOLD}Budget OK (usage untracked — thresholds shown for reference)${NC}\n"; return 0
        fi
      }

      if $is_override; then
        local _rc=0
        _print_budget_section "$budget_file" "[project]" || _rc=$?
        if [ -f "$global_file" ]; then
          local g_warn g_hard
          read -r g_warn g_hard <<< "$(python3 -c "
import json; d=json.load(open('$global_file'))
print(d.get('warn',1500000), d.get('hard',0))" 2>/dev/null)" \
            || { g_warn=1500000; g_hard=0; }
          echo -e "${DIM}  global ($global_file)${NC}"
          printf "  ${DIM}%-20s %s${NC}\n" "Warn at:"   "$(human_tokens "$g_warn")"
          printf "  ${DIM}%-20s %s${NC}\n" "Hard stop:" "$(if [ "$g_hard" -eq 0 ]; then echo 'unlimited'; else human_tokens "$g_hard"; fi)"
          echo ""
        fi
        return $_rc
      else
        local _rc=0
        _print_budget_section "$budget_file" "[global]" || _rc=$?
        return $_rc
      fi
      ;;

    --check)
      if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: token-diet budget --check --transcript <file>"
        echo ""
        echo "  Estimate a session transcript's token size and warn once per"
        echo "  threshold band (default 100000, or .token-budget's ctx_threshold)."
        echo "  Always exits 0 — a warn arm must never fail a turn."
        return 0
      fi
      python3 "$SCRIPT_DIR/lib/ctxwarn.py" "$@"
      ;;

    *)
      echo "Usage: token-diet budget <init|status|--check>" >&2
      return 1
      ;;
  esac
}

cmd_route() {
  local task="${1:-}"
  if [[ -z "$task" ]]; then
    echo "Usage: token-diet route <task description>"
    exit 1
  fi

  local lower
  lower=$(echo "$task" | tr '[:upper:]' '[:lower:]')

  if [[ "$lower" =~ (rename|refactor|reference|diagnostic|navigate|symbol|lsp|find.*def|go.to) ]]; then
    echo -e "${BOLD}→ Serena${NC} (LSP navigation)"
    echo "  Best for: rename, refactor, find references, diagnostics, symbol search"
    echo "  Command:  use serena MCP tools (rename_symbol, find_referencing_symbols)"
  elif [[ "$lower" =~ (docs|documentation|library|api|framework|version|changelog|how do i|setup.*lib) ]]; then
    echo -e "${BOLD}→ context7${NC} (remote library documentation)"
    echo "  Best for: up-to-date docs and API lookups for a named library or framework"
    echo "  Command:  use the context7 MCP tools (resolve-library-id, get-library-docs)"
  elif [[ "$lower" =~ (remember|recall|memory|memoir|forget|persist|what did|last (time|session)|prior (decision|session|work)) ]]; then
    echo -e "${BOLD}→ ICM${NC} (persistent memory)"
    echo "  Best for: recalling past decisions, storing facts, cross-session/cross-tool memory"
    echo "  Command:  use icm MCP tools (recall, remember) — shared across Claude/Codex/Gemini/OpenCode"
  else
    echo -e "${BOLD}No clear match${NC} — these components may apply:"
    echo ""
    echo "  Serena   — renaming/navigating symbols (LSP-powered)"
    echo "  context7 — library docs and API lookups (remote MCP)"
    echo "  ICM      — recalling/storing memory across sessions and tools"
  fi
}

cmd_extract() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: token-diet extract <file>"
    echo ""
    echo "  Extract a document (pdf/csv/html/txt) to a hash-cached plain-text"
    echo "  file and print the cache path. Exit codes: 2 no extractor for this"
    echo "  type, 3 needs markitdown (docx/pptx/xlsx/epub/odt/rtf), 4 missing file."
    return 0
  fi
  python3 "$SCRIPT_DIR/lib/docextract.py" "$@"
}

cmd_test_first() {
  local file="${1:-}"
  if [[ -z "$file" ]]; then
    echo "Usage: token-diet test-first <file>"
    exit 1
  fi

  local basename="${file##*/}"
  local name="${basename%.*}"
  local ext="${basename##*.}"
  local dir="${file%/*}"
  [[ "$dir" == "$file" ]] && dir="."

  echo "Test candidates for ${BOLD}${file}${NC}:"
  echo ""

  case "$ext" in
    py)
      echo "  tests/test_${name}.py"
      echo "  test_${name}.py"
      echo "  ${dir}/test_${name}.py"
      ;;
    rs)
      echo "  tests/${name}_test.rs"
      echo "  tests/test_${name}.rs"
      echo "  ${dir}/${name}_test.rs  (inline #[cfg(test)] module)"
      ;;
    ts|tsx)
      echo "  ${dir}/${name}.test.ts"
      echo "  ${dir}/${name}.spec.ts"
      echo "  tests/${name}.test.ts"
      ;;
    js|jsx)
      echo "  ${dir}/${name}.test.js"
      echo "  ${dir}/${name}.spec.js"
      echo "  tests/${name}.test.js"
      ;;
    go)
      echo "  ${dir}/${name}_test.go"
      ;;
    *)
      echo "  tests/test_${name}.${ext}"
      echo "  ${dir}/test_${name}.${ext}"
      ;;
  esac

  echo ""
  echo "  Tip: read the test file first to understand expected behavior before the implementation"
}

cmd_strip() {
  local STATS=false
  local file=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stats) STATS=true; shift ;;
      -*)      echo "Unknown option: $1"; echo "Usage: token-diet strip [--stats] <file>"; exit 1 ;;
      *)       file="$1"; shift ;;
    esac
  done

  if [[ -z "$file" ]]; then
    echo "Usage: token-diet strip [--stats] <file>"
    exit 1
  fi

  if [[ ! -f "$file" ]]; then
    echo "File not found: $file"
    exit 1
  fi

  local ext="${file##*.}"
  case "$ext" in
    js|ts|jsx|tsx|java|c|cpp|h|cs|go|swift|kt)
      # Strip // single-line comments
      local stripped
      stripped=$(python3 - "$file" << 'PY'
import sys, re
with open(sys.argv[1]) as f:
    content = f.read()
# Remove // line comments (not inside strings — best-effort)
lines = []
for line in content.splitlines():
    # Remove // comment (simple: not string-aware)
    cleaned = re.sub(r'\s*//.*$', '', line)
    lines.append(cleaned)
print('\n'.join(lines))
PY
)
      ;;
    *)
      # Default: strip # comments (Python, bash, ruby, etc.)
      local stripped
      stripped=$(python3 - "$file" << 'PY'
import sys, re
with open(sys.argv[1]) as f:
    lines = f.readlines()
out = []
for line in lines:
    # Remove full-line comments
    stripped = re.sub(r'^\s*#.*\n?', '', line)
    # Remove inline comments (not inside strings — best-effort)
    stripped = re.sub(r'\s+#[^!\n].*$', '', stripped.rstrip('\n'))
    out.append(stripped)
# Filter out lines that became empty due to comment removal
# but preserve blank lines that were originally blank
result = []
for orig, s in zip(lines, out):
    orig_stripped = orig.strip()
    if orig_stripped.startswith('#'):
        continue  # was a comment line — skip
    result.append(s)
print('\n'.join(result))
PY
)
      ;;
  esac

  if [[ "$STATS" == true ]]; then
    local orig_lines stripped_lines
    orig_lines=$(wc -l < "$file")
    stripped_lines=$(echo "$stripped" | wc -l)
    local saved=$(( orig_lines - stripped_lines ))
    local pct=0
    if [[ $orig_lines -gt 0 ]]; then
      pct=$(python3 -c "print(round($saved * 100 / $orig_lines, 1))")
    fi
    echo "$stripped"
    echo ""
    echo "Lines: $orig_lines → $stripped_lines  (saved $saved lines, ${pct}% reduction)"
  else
    echo "$stripped"
  fi
}

cmd_diff_reads() {
  local file="${1:-}"

  if [[ -z "$file" ]]; then
    echo "Usage: token-diet diff-reads <file>"
    exit 1
  fi

  if [[ ! -f "$file" ]]; then
    echo "File not found: $file"
    exit 1
  fi

  # Find repo root
  local repo_root
  repo_root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null) || {
    echo "Not a git repository: $file"
    exit 1
  }

  # Get changed line ranges from git diff (unstaged + staged)
  local rel_path
  rel_path=$(realpath --relative-to="$repo_root" "$file" 2>/dev/null || python3 -c "
import os, sys
print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$file" "$repo_root")

  # Combine staged and unstaged diffs
  local ranges
  ranges=$(git -C "$repo_root" diff HEAD -- "$rel_path" 2>/dev/null; \
           git -C "$repo_root" diff --cached -- "$rel_path" 2>/dev/null)

  if [[ -z "$ranges" ]]; then
    # No uncommitted changes — check last commit
    ranges=$(git -C "$repo_root" diff HEAD~1 HEAD -- "$rel_path" 2>/dev/null || true)
  fi

  if [[ -z "$ranges" ]]; then
    echo "No recent changes detected for: $rel_path"
    echo "Suggest reading the full file."
    exit 0
  fi

  # Parse @@ -a,b +c,d @@ hunks to extract new-file line ranges
  echo "Changed regions in $rel_path:"
  echo ""
  python3 - "$ranges" << 'PY'
import sys, re
content = sys.argv[1]
hunks = re.findall(r'@@ [^@]+ \+(\d+)(?:,(\d+))? @@', content)
if not hunks:
    print("  (no line range info available)")
else:
    for start_s, count_s in hunks:
        start = int(start_s)
        count = int(count_s) if count_s else 1
        end = start + count - 1
        if count == 0:
            print(f"  (deletion at line {start})")
        elif start == end:
            print(f"  line {start}")
        else:
            print(f"  lines {start}-{end}  (Read offset={start-1} limit={count})")
PY
}

cmd_serena_gc() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true

  echo -e "\n${BOLD}token-diet serena-gc${NC}  — orphan/zombie process cleanup\n"

  # Patterns known to be spawned by Serena (MCP server + language servers)
  local -a patterns=("serena" "pylsp" "pyright-langserver" "jdtls" "rust-analyzer" "gopls" "typescript-language-server" "clangd" "solargraph")

  local -a found_pids=()
  local -a found_cmds=()

  for pat in "${patterns[@]}"; do
    local raw
    raw=$(pgrep -f "$pat" 2>/dev/null) || continue
    while IFS= read -r pid; do
      [[ -z "$pid" ]] && continue
      [[ "$pid" == "$$" ]] && continue  # skip self
      local ppid cmd
      ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') || continue
      cmd=$(ps -o args= -p "$pid" 2>/dev/null | cut -c1-72) || cmd="(unknown)"
      # Orphan = parent is init (ppid=1) or parent process is dead
      local is_orphan=false
      if [[ "$ppid" == "1" ]]; then
        is_orphan=true
      elif ! kill -0 "$ppid" 2>/dev/null; then
        is_orphan=true
      fi
      if $is_orphan; then
        found_pids+=("$pid")
        found_cmds+=("$cmd")
      fi
    done <<< "$raw"
  done

  if [[ ${#found_pids[@]} -eq 0 ]]; then
    ok "No orphaned Serena or language server processes found"
    echo ""
    return 0
  fi

  echo -e "  ${YELLOW}${BOLD}${#found_pids[@]} orphaned process(es) found:${NC}"
  echo ""
  for i in "${!found_pids[@]}"; do
    printf "  ${RED}✗${NC}  PID %-8s %s\n" "${found_pids[$i]}" "${found_cmds[$i]}"
  done
  echo ""

  if $force; then
    # Graceful SIGTERM first, then SIGKILL after 2s
    for pid in "${found_pids[@]}"; do
      kill -TERM "$pid" 2>/dev/null || true
    done
    sleep 2
    local killed=0
    for pid in "${found_pids[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
        killed=$(( killed + 1 ))
      fi
    done
    ok "Sent SIGTERM to ${#found_pids[@]} process(es)$([ $killed -gt 0 ] && echo ", SIGKILL to ${killed} that did not exit")"
  else
    echo -e "  Run ${BOLD}token-diet serena-gc --force${NC} to terminate them"
  fi
  echo ""
}

_serena_runtime_mode() {
  # Returns: docker-running, uvx, docker-image, or none
  if check_cmd docker && docker ps --filter ancestor=token-diet/serena:latest --format "{{.ID}}" 2>/dev/null | grep -q "."; then
    echo "docker-running"
  elif check_cmd uvx && { uvx serena --version &>/dev/null || uvx --from "git+https://github.com/artificemachine/serena" serena --help &>/dev/null; }; then
    echo "uvx"
  elif check_cmd docker && docker image inspect token-diet/serena:latest &>/dev/null; then
    echo "docker-image"
  else
    echo "none"
  fi
}

cmd_serena_status() {
  local mode; mode=$(_serena_runtime_mode)
  echo -e "\n${BOLD}token-diet serena-status${NC}\n"
  
  case "$mode" in
    docker-running)
      local cid; cid=$(docker ps --filter ancestor=token-diet/serena:latest --format "{{.ID}}")
      ok "Serena runtime: Docker (container running: $cid)"
      ;;
    docker-image)
      warn "Serena runtime: Docker image present, but container NOT running"
      echo "  Run: docker compose -f docker/compose.yml up serena"
      ;;
    uvx)
      ok "Serena runtime: uvx (managed)"
      ;;
    *)
      miss "Serena runtime: NOT FOUND (neither uvx nor Docker usable)"
      ;;
  esac

  echo ""
  printf "  %-24s %s\n" "uvx available:" "$(check_cmd uvx && echo 'true' || echo 'false')"
  printf "  %-24s %s\n" "Docker available:" "$(check_cmd docker && echo 'true' || echo 'false')"
  if check_cmd docker; then
    printf "  %-24s %s\n" "Docker image built:" "$(docker image inspect token-diet/serena:latest &>/dev/null && echo 'true' || echo 'false')"
  fi
  echo ""
}

cmd_repair() {
  local dry_run=false json_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --json)    json_mode=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  local repairs=0 failures=0
  local -a repaired=() failed=() skipped=()
  _repaired() { repaired+=("$1"); repairs=$(( repairs + 1 )); }
  _failed()   { failed+=("$1");   failures=$(( failures + 1 )); }
  _skipped()  { skipped+=("$1"); }

  $json_mode || {
    echo -e "\n${BOLD}token-diet repair${NC}"
    $dry_run && echo -e "${DIM}  Dry-run mode — no changes will be made${NC}"
    echo ""
  }

  # ── 1. JSON MCP stale commands ───────────────────────────────────────────
  _repair_mcp_json() {
    local tool="$1" host_label="$2" cfg="$3"
    [ -f "$cfg" ] || return 0

    local registered
    registered=$(python3 - "$cfg" "$tool" << 'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    # OpenCode uses "mcp"; every other host uses "mcpServers". cmd_doctor
    # already reads both — repair must too, or it reports nothing to fix on
    # exactly the configs doctor flags.
    servers = d.get("mcpServers") or d.get("mcp") or {}
    key = next((k for k in servers if sys.argv[2].lower() in k.lower()), None)
    if key is None: sys.exit(1)
    cmd = servers[key].get("command", "")
    # OpenCode's "command" is an argv array; the binary is element 0.
    print(cmd[0] if isinstance(cmd, list) and cmd else (cmd if isinstance(cmd, str) else ""))
except Exception:
    sys.exit(1)
PY
    2>/dev/null) || return 0  # not registered — skip silently

    [ -n "$registered" ] || return 0
    mcp_command_exists "$registered" && return 0  # healthy

    # Stale command — find current path
    local new_path; new_path=$(command -v "$tool" 2>/dev/null || echo "")
    if [ -z "$new_path" ]; then
      $json_mode || miss "  ${host_label}  ${tool}: stale '${registered}' and '${tool}' not in PATH"
      _failed "${tool} ${host_label}: stale command and '${tool}' not in PATH — cannot repair"
      return 0
    fi

    if $dry_run; then
      $json_mode || warn "  ${host_label}  ${tool}: would update '${registered}' → '${new_path}'"
      _skipped "${tool} ${host_label}: dry-run — would update command to ${new_path}"
      return 0
    fi

    TD_LIB_DIR="$SCRIPT_DIR/lib" python3 - "$cfg" "$tool" "$new_path" << 'PY'
import os, sys
sys.path.insert(0, os.environ["TD_LIB_DIR"])
import tdconfig

cfg_path, tool_name, new_cmd = sys.argv[1], sys.argv[2], sys.argv[3]

def mutate(d):
    # Match the dialect the read side resolved: OpenCode "mcp" vs "mcpServers".
    servers = d.get("mcpServers") or d.get("mcp") or {}
    key = next((k for k in servers if tool_name.lower() in k.lower()), None)
    if key is None:
        return False          # nothing to change; skip the write entirely
    existing = servers[key].get("command")
    if isinstance(existing, list) and existing:
        # Preserve the rest of the argv (e.g. ["icm", "mcp"]); swap only
        # the binary. Rewriting it to a bare string would break OpenCode,
        # whose >=1.18 schema requires command to be an array.
        servers[key]["command"] = [new_cmd] + existing[1:]
    else:
        servers[key]["command"] = new_cmd

# This was already atomic via os.replace, but hand-rolled: no fsync, no mode
# preservation, no backup, and an unhandled json.load raising a raw traceback
# on a malformed config. tdconfig covers all four.
try:
    tdconfig.update_json(cfg_path, mutate)
except tdconfig.ConfigError as _e:
    print(f"[token-diet] skipped {cfg_path}: {_e}", file=sys.stderr)
    sys.exit(1)
PY
    if [ $? -eq 0 ]; then
      $json_mode || ok "  ${host_label}  ${tool}: updated command → ${new_path}"
      _repaired "${tool} ${host_label}: updated stale command to ${new_path}"
    else
      $json_mode || miss "  ${host_label}  ${tool}: failed to update config"
      _failed "${tool} ${host_label}: JSON write failed"
    fi
  }

  local cc_cfg="$HOME/.claude/settings.json"
  local cc_global="$HOME/.claude.json"
  local cd_mac="$HOME/Library/Application Support/Claude/claude_desktop_config.json"
  local cd_linux="$HOME/.config/Claude/claude_desktop_config.json"
  # OpenCode: prefer XDG path if it exists, fall back to legacy. Must match
  # cmd_doctor's resolution exactly — repair previously only looked at the
  # legacy path, so on an XDG-layout install (what install.sh writes) doctor
  # would report a broken OpenCode entry that repair then silently skipped.
  local oc_cfg="$HOME/.opencode.json"
  [ -f "$HOME/.config/opencode/opencode.json" ] && oc_cfg="$HOME/.config/opencode/opencode.json"

  local _mcp_tool
  # context7 is a remote HTTP server (a URL registration, not a local binary),
  # so stale-command repair does not apply to it.
  for _mcp_tool in serena icm; do
    _repair_mcp_json "$_mcp_tool" "claude-code"    "$cc_cfg"
    _repair_mcp_json "$_mcp_tool" "claude-desktop" "$cd_mac"
    _repair_mcp_json "$_mcp_tool" "claude-desktop" "$cd_linux"
    _repair_mcp_json "$_mcp_tool" "opencode"       "$oc_cfg"
  done

  # ── 2. Codex TOML — stale commands flagged as manual only ────────────────
  local codex_cfg="$HOME/.codex/config.toml"
  if [ -f "$codex_cfg" ]; then
    for _mcp_tool in serena icm; do
      local codex_cmd; codex_cmd=$(codex_mcp_command "$_mcp_tool" 2>/dev/null || echo "")
      [ -n "$codex_cmd" ] || continue
      if ! mcp_command_exists "$codex_cmd"; then
        $json_mode || warn "  codex  ${_mcp_tool}: stale '${codex_cmd}' — edit ~/.codex/config.toml manually"
        _skipped "${_mcp_tool} codex: stale command '${codex_cmd}' — edit ~/.codex/config.toml manually"
      fi
    done
  fi

  # ── 3. Summary ───────────────────────────────────────────────────────────
  if $json_mode; then
    python3 - "$repairs" "$failures" "$dry_run" \
      "REPAIRED_SEP" "${repaired[@]+"${repaired[@]}"}" \
      "FAILED_SEP"   "${failed[@]+"${failed[@]}"}" \
      "SKIPPED_SEP"  "${skipped[@]+"${skipped[@]}"}" << 'PY'
import json, sys
repairs  = int(sys.argv[1])
failures = int(sys.argv[2])
is_dry   = sys.argv[3] == "true"
repaired, failed, skipped, current = [], [], [], None
for a in sys.argv[4:]:
    if   a == "REPAIRED_SEP": current = repaired
    elif a == "FAILED_SEP":   current = failed
    elif a == "SKIPPED_SEP":  current = skipped
    elif current is not None: current.append(a)
result = {
    "repairs": repairs, "failures": failures,
    "repaired": repaired, "failed": failed, "skipped": skipped,
    "healthy": failures == 0,
}
if is_dry:
    result["dry_run"] = True
print(json.dumps(result, indent=2))
PY
  else
    echo ""
    echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
    if [ "$failures" -eq 0 ] && [ "$repairs" -gt 0 ]; then
      echo -e "\n  ${GREEN}${BOLD}Repaired ${repairs} issue(s)${NC}\n"
    elif [ "$failures" -eq 0 ]; then
      echo -e "\n  ${GREEN}${BOLD}Nothing to repair — stack is healthy${NC}\n"
    else
      echo -e "\n  ${RED}${BOLD}${failures} repair(s) failed — manual action required:${NC}"
      local _f
      for _f in "${failed[@]}"; do
        echo -e "  ${RED}→${NC}  ${_f}"
      done
      echo ""
    fi
  fi

  return "$(( failures > 0 ))"
}

cmd_doctor() {
  local json_mode=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_mode=true; shift ;;
      *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
  done

  local issues=0
  local -a findings=() compat_results=()
  _issue() { findings+=("$1"); issues=$(( issues + 1 )); }

  $json_mode || echo -e "\n${BOLD}token-diet doctor${NC}\n"

  # ── 1. Binaries ─────────────────────────────────────────────────────────────
  $json_mode || { echo -e "${BOLD}Binaries${NC}"; \
                  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"; }

  local serena_ok=false icm_ok=false icm_ver=""

  local uvx_ok=false uv_ok=false
  { check_cmd uvx && uvx --version &>/dev/null 2>&1; } && uvx_ok=true || true
  { check_cmd uv  && uv  --version &>/dev/null 2>&1; } && uv_ok=true  || true

  if $uvx_ok || $uv_ok || \
     docker image inspect token-diet/serena:latest &>/dev/null 2>&1; then
    serena_ok=true
    if $uvx_ok; then
      $json_mode || ok "serena  runtime: uvx   ${DIM}$(command -v uvx)${NC}"
    elif $uv_ok; then
      $json_mode || ok "serena  runtime: uv    ${DIM}$(command -v uv)${NC}"
    else
      $json_mode || ok "serena  runtime: docker image token-diet/serena:latest"
    fi
  else
    $json_mode || miss "serena  no runtime found  →  install uvx or build docker image"
    _issue "serena: no runtime (uvx/uv/docker)"
  fi

  if check_cmd icm && icm --version &>/dev/null 2>&1; then
    icm_ok=true
    icm_ver=$(icm --version 2>/dev/null | awk '{print $2}')
    $json_mode || ok "icm     ${icm_ver}   ${DIM}$(command -v icm)${NC}"
    local _icm_min; _icm_min=$(_compat_min "icm")
    if _semver_ok "$icm_ver" "$_icm_min"; then
      compat_results+=("icm:ok:${icm_ver}:${_icm_min}")
    else
      $json_mode || warn "icm ${icm_ver} is below minimum ${_icm_min} — upgrade ICM"
      _issue "compat: icm ${icm_ver} below minimum ${_icm_min}"
      compat_results+=("icm:warn:${icm_ver}:${_icm_min}")
    fi
  else
    $json_mode || miss "icm     not found  →  run: bash install.sh --icm-only"
    _issue "icm: binary missing"
  fi

  # context7 is a remote HTTP MCP server — no local binary. Presence is checked
  # in the MCP registrations section below (registered-in-any-host).

  # ── 2. MCP registrations ────────────────────────────────────────────────────
  $json_mode || { echo ""; echo -e "${BOLD}MCP registrations${NC}"; \
                  echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"; }

  local cc_cfg="$HOME/.claude/settings.json"
  local cc_global="$HOME/.claude.json"
  local cd_mac="$HOME/Library/Application Support/Claude/claude_desktop_config.json"
  local cd_linux="$HOME/.config/Claude/claude_desktop_config.json"
  # OpenCode: prefer XDG path if it exists, fall back to legacy.
  local oc_cfg="$HOME/.opencode.json"
  [ -f "$HOME/.config/opencode/opencode.json" ] && oc_cfg="$HOME/.config/opencode/opencode.json"
  local -a serena_registered_hosts=() icm_registered_hosts=() context7_registered_hosts=()

  _doctor_check_mcp_json() {
    local tool="$1" host_label="$2" cfg="$3" hosts_var="$4" silent_miss="${5:-}" assume_installed="${6:-}"
    # host not installed — skip silently, UNLESS the caller already confirmed
    # this host via a sibling config path (assume_installed): in that case a
    # missing file here means genuinely "not registered", not "not installed".
    if [ ! -f "$cfg" ] && [ -z "$assume_installed" ]; then
      return 0
    fi

    local registered
    registered=$(python3 - "$cfg" "$tool" << 'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    # Merge mcpServers and mcp keys (opencode uses "mcp"; others use "mcpServers")
    servers = {**d.get("mcpServers", {}), **d.get("mcp", {})}
    key = next((k for k in servers if sys.argv[2].lower() in k.lower()), None)
    if key is None:
        sys.exit(1)
    v = servers[key]
    cmd = v.get("command", "")
    # opencode "command" may be a list
    if isinstance(cmd, list): cmd = " ".join(cmd)
    args = v.get("args", [])
    print(cmd + (" " + " ".join(str(a) for a in args) if args else ""))
except Exception:
    sys.exit(1)
PY
    2>/dev/null)

    if [ -n "$registered" ]; then
      eval "${hosts_var}+=(\"$host_label\")"
      local first_word; first_word=$(echo "$registered" | awk '{print $1}')
      if mcp_command_exists "$first_word"; then
        $json_mode || ok "  ${host_label}   registered   ${DIM}${registered}${NC}"
      else
        $json_mode || warn "  ${host_label}   registered but command missing: ${first_word}"
        _issue "${tool} ${host_label}: registered but '${first_word}' not in PATH"
      fi
    else
      if [ -z "$silent_miss" ]; then
        $json_mode || miss "  ${host_label}   not registered  →  run: bash install.sh"
        _issue "${tool} ${host_label}: not registered"
      fi
    fi
  }

  _doctor_check_mcp_codex() {
    local tool="$1" hosts_var="$2"
    [ -f "$HOME/.codex/config.toml" ] || return 0
    local codex_cmd; codex_cmd=$(codex_mcp_command "$tool" 2>/dev/null || echo "")
    if [ -n "$codex_cmd" ]; then
      eval "${hosts_var}+=(\"codex\")"
      if mcp_command_exists "$codex_cmd"; then
        $json_mode || ok "  codex       registered   ${DIM}${codex_cmd}${NC}"
      else
        $json_mode || warn "  codex       registered but command missing: ${codex_cmd}"
        _issue "${tool} codex: registered but '${codex_cmd}' not in PATH"
      fi
    else
      $json_mode || miss "  codex       not registered  →  run: bash install.sh"
      _issue "${tool} codex: not registered"
    fi
  }

  _doctor_check_mcp_gemini() {
    local tool="$1" hosts_var="$2"
    command -v gemini >/dev/null 2>&1 || return 0
    # Read ~/.gemini/settings.json directly — `gemini mcp list` probes live
    # connections and blocks for seconds per server. The config file is instant.
    local gemini_settings="$HOME/.gemini/settings.json"
    local gemini_registered=false
    if [ -f "$gemini_settings" ]; then
      # if-condition form: the probe legitimately exits 1 when the tool is not
      # registered, and a bare non-zero command here would trip `set -e` and
      # kill doctor before it prints anything.
      if python3 - "$gemini_settings" "$tool" << 'PY' 2>/dev/null
import json,sys
d=json.load(open(sys.argv[1]))
servers={**d.get('mcpServers',{}),**d.get('mcp',{})}
sys.exit(0 if any(sys.argv[2] in k.lower() for k in servers.keys()) else 1)
PY
      then
        gemini_registered=true
      fi
    fi
    if $gemini_registered; then
      eval "${hosts_var}+=(\"gemini\")"
      $json_mode || ok "  gemini      registered"
    else
      $json_mode || miss "  gemini      not registered  →  run: bash install.sh"
      _issue "${tool} gemini: not registered"
    fi
  }

  # _doctor_check_mcp_json_either: check two files for the same host — only
  # report miss if BOTH miss. Claude Code writes to ~/.claude.json (via
  # 'claude mcp add --scope user') but some older entries live in
  $json_mode || echo -e "  ${BOLD}serena${NC}"
  # Claude Code: check both ~/.claude/settings.json and ~/.claude.json.
  # Run settings.json first; only run .claude.json if settings.json missed (to avoid
  # double-printing). The issues counter is reset before each attempt so a miss on
  # settings.json doesn't count if .claude.json succeeds.
  _doctor_check_mcp_json "serena" "claude-code" "$cc_cfg"    "serena_registered_hosts" "silent"
  if ! printf '%s\n' "${serena_registered_hosts[@]+"${serena_registered_hosts[@]}"}" | grep -q "^claude-code$"; then
    # If settings.json exists, claude-code is installed even when .claude.json
    # is absent — a miss here is genuinely "not registered", not "not installed".
    local cc_installed=""; [ -f "$cc_cfg" ] && cc_installed="1"
    _doctor_check_mcp_json "serena" "claude-code" "$cc_global" "serena_registered_hosts" "" "$cc_installed"
  else
    $json_mode || ok "  claude-code   registered"
  fi
  _doctor_check_mcp_json "serena" "claude-desktop" "$cd_mac"    "serena_registered_hosts"
  _doctor_check_mcp_json "serena" "claude-desktop" "$cd_linux"  "serena_registered_hosts"
  _doctor_check_mcp_json "serena" "opencode"       "$oc_cfg"    "serena_registered_hosts"
  _doctor_check_mcp_codex "serena" "serena_registered_hosts"
  _doctor_check_mcp_gemini "serena" "serena_registered_hosts"
  $json_mode || echo ""

  # icm: same per-host pattern as serena
  $json_mode || echo -e "  ${BOLD}icm${NC}"
  _doctor_check_mcp_json "icm" "claude-code" "$cc_cfg"    "icm_registered_hosts" "silent"
  if ! printf '%s\n' "${icm_registered_hosts[@]+"${icm_registered_hosts[@]}"}" | grep -q "^claude-code$"; then
    local cc_installed=""; [ -f "$cc_cfg" ] && cc_installed="1"
    _doctor_check_mcp_json "icm" "claude-code" "$cc_global" "icm_registered_hosts" "" "$cc_installed"
  else
    $json_mode || ok "  claude-code   registered"
  fi
  _doctor_check_mcp_json "icm" "claude-desktop" "$cd_mac"    "icm_registered_hosts"
  _doctor_check_mcp_json "icm" "claude-desktop" "$cd_linux"  "icm_registered_hosts"
  _doctor_check_mcp_json "icm" "opencode"       "$oc_cfg"    "icm_registered_hosts"
  _doctor_check_mcp_codex "icm" "icm_registered_hosts"
  _doctor_check_mcp_gemini "icm" "icm_registered_hosts"
  $json_mode || echo ""

  # context7: remote HTTP MCP server (https://mcp.context7.com/mcp) — there is
  # no local binary or per-host command to validate, so a single
  # registered-in-any-host check via the shared hosts_registered machinery
  # replaces the per-host walk used for serena/icm.
  $json_mode || echo -e "  ${BOLD}context7${NC}"
  local c7_hosts; c7_hosts=$(hosts_registered "context7")
  if [ "$c7_hosts" != "none" ]; then
    local _h
    IFS=',' read -ra context7_registered_hosts <<< "$c7_hosts"
    for _h in "${context7_registered_hosts[@]}"; do
      $json_mode || ok "  ${_h}   registered   ${DIM}https://mcp.context7.com/mcp${NC}"
    done
  else
    $json_mode || warn "  not registered in any MCP host  →  register via install.sh (optional CONTEXT7_API_KEY; the key is appended to the URL at registration time and never echoed)"
    _issue "context7: not registered in any MCP host"
  fi
  $json_mode || echo ""

  # ── 3. Summary ──────────────────────────────────────────────────────────────
  if $json_mode; then
    python3 - "$issues" \
      "FINDINGS_SEP" "${findings[@]+"${findings[@]}"}" \
      "COMPAT_SEP"   "${compat_results[@]+"${compat_results[@]}"}" \
      "SERENA_HOSTS_SEP" "${serena_registered_hosts[@]+"${serena_registered_hosts[@]}"}" \
      "ICM_HOSTS_SEP"    "${icm_registered_hosts[@]+"${icm_registered_hosts[@]}"}" \
      "CONTEXT7_HOSTS_SEP" "${context7_registered_hosts[@]+"${context7_registered_hosts[@]}"}" << 'PY'
import json, sys
args = sys.argv[1:]; issues = int(args[0])
findings, compat_raw, serena_hosts, icm_hosts, context7_hosts, current = [], [], [], [], [], None
for a in args[1:]:
    if a == "FINDINGS_SEP": current = findings; continue
    if a == "COMPAT_SEP": current = compat_raw; continue
    if a == "SERENA_HOSTS_SEP": current = serena_hosts; continue
    if a == "ICM_HOSTS_SEP": current = icm_hosts; continue
    if a == "CONTEXT7_HOSTS_SEP": current = context7_hosts; continue
    if current is not None: current.append(a)
compat = {}
for entry in compat_raw:
    parts = entry.split(":", 3)
    if len(parts) == 4:
        tool, status, ver, min_ver = parts
        compat[tool] = {"status": status, "version": ver, "min": min_ver}
out = {"issues": issues, "healthy": issues == 0, "findings": findings, "compat": compat, "serena_mcp": { "registered_hosts": serena_hosts }, "icm_mcp": { "registered_hosts": icm_hosts }, "context7_mcp": { "registered_hosts": context7_hosts }}
print(json.dumps(out, indent=2))
PY
  else
    echo -e "${DIM}$(printf '%.0s─' {1..50})${NC}"
    if [ "$issues" -eq 0 ]; then
      echo -e "\n  ${GREEN}${BOLD}All checks passed — stack is healthy${NC}\n"
    else
      echo -e "\n  ${YELLOW}${BOLD}${issues} issue(s) found:${NC}"
      local f
      for f in "${findings[@]}"; do
        echo -e "  ${RED}→${NC}  ${f}"
      done
      echo -e "\n  Run ${BOLD}bash install.sh${NC} to repair most issues.\n"
    fi
  fi

  return "$(( issues > 0 ))"
}

# ICM memory management. `warmup` performs the one-time embedding-model download
# (kept off by default so nothing is fetched silently behind a firewall); `status`
# reports version, MCP hosts, and whether semantic search is enabled.
cmd_icm() {
  local sub="${1:-help}"
  local icm_cfg="$HOME/.config/icm/config.toml"
  case "$sub" in
    warmup)
      if ! check_cmd icm; then
        miss "ICM not installed  →  run: bash install.sh --icm-only"
        exit 1
      fi
      echo -e "\n${BOLD}ICM warmup${NC} ${DIM}— enable semantic memory${NC}\n"
      echo "Downloads the embedding model (intfloat/multilingual-e5-base, ~270 MB)"
      echo "from Hugging Face ONE time. ICM runs fully offline afterwards."
      echo ""
      if [ -t 0 ]; then
        printf "  Proceed with the one-time download? [y/N] "
        local ans; read -r ans || true
        case "$ans" in [Yy]*) ;; *) echo "Aborted."; exit 0 ;; esac
      fi
      mkdir -p "$(dirname "$icm_cfg")"
      python3 - "$icm_cfg" << 'PY'
import os, sys, re, pathlib, tempfile
def atomic_write(path, text):
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".td-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError:
            pass
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
p = pathlib.Path(sys.argv[1])
text = p.read_text() if p.exists() else ""
# Flip enabled=true strictly inside the [embeddings] table.
m = re.search(r'(?ms)^\[embeddings\][^\n]*\n(.*?)(?=^\[|\Z)', text)
if m:
    body = m.group(1)
    if re.search(r'(?m)^\s*enabled\s*=', body):
        body = re.sub(r'(?m)^(\s*enabled\s*=\s*).*$', r'\g<1>true', body, count=1)
    else:
        body = "enabled = true\n" + body
    text = text[:m.start(1)] + body + text[m.end(1):]
else:
    prefix = text.rstrip() + "\n\n" if text.strip() else ""
    text = prefix + "[embeddings]\nenabled = true\n"
atomic_write(str(p), text)
PY
      echo "  Embeddings enabled in $icm_cfg"
      echo "  Fetching model (first run may take a few minutes)..."
      # A recall query embeds its text, forcing the model fetch without writing memory.
      if icm recall "token-diet warmup probe" >/dev/null 2>&1; then
        ok "ICM model ready — semantic recall is active (offline from here on)"
      else
        warn "Warmup query returned nothing (normal if memory is empty)."
        echo "  If the download failed: check access to huggingface.co, and confirm ICM"
        echo "  was built with embeddings (online install — the --local build is keyword-only)."
      fi
      ;;
    status)
      if ! check_cmd icm; then miss "ICM not installed"; exit 1; fi
      local enabled="default(true)"
      if [ -f "$icm_cfg" ]; then
        enabled=$(python3 - "$icm_cfg" << 'PY'
import sys, re, pathlib
text = pathlib.Path(sys.argv[1]).read_text()
m = re.search(r'(?ms)^\[embeddings\][^\n]*\n(.*?)(?=^\[|\Z)', text)
val = "default(true)"
if m:
    em = re.search(r'(?m)^\s*enabled\s*=\s*(\w+)', m.group(1))
    if em: val = em.group(1)
print(val)
PY
)
      fi
      echo -e "\n${BOLD}ICM status${NC}\n"
      printf "  %-22s %s\n" "Version:"    "$(icm --version 2>/dev/null | awk '{print $2}')"
      printf "  %-22s %s\n" "MCP hosts:"  "$(hosts_registered icm)"
      printf "  %-22s %s\n" "Embeddings:" "$enabled"
      echo ""
      ;;
    *)
      echo "Usage: token-diet icm [warmup|status]"
      echo ""
      echo "  warmup   One-time embedding-model download (~270 MB); enables semantic recall"
      echo "  status   Show ICM version, MCP hosts, and embeddings on/off"
      ;;
  esac
}

cmd_help() {
  cat << helpEOF

token-diet — token optimization stack dashboard

USAGE
  token-diet [command]

COMMANDS
  status            Show component status dashboard  (default)
  health            Quick health check: components responding + MCP host registrations
  doctor            Deep configuration diagnosis  [--json]
  repair            Fix what doctor finds: stale MCP commands  [--dry-run] [--json]
  mcp               Manage MCP server registrations  [install|list]
  upstream          Manage and verify original repository updates  [setup|check|diff]
  budget <init|status|hubs> Per-project token budget with hubs discovery
  route <task>      Suggest which component (Serena/context7/ICM) best fits the task
  icm <sub>         ICM memory: warmup (download model), status  [warmup|status]
  extract <file>    Extract a document (pdf/csv/html/txt) to a cached plain-text file
  test-first <file> Suggest test file counterpart for an implementation file
  strip [--stats] <file>  Strip comments from source file to reduce tokens
  diff-reads <file> Suggest line ranges to read based on recent git diff
  serena-gc         Detect and kill orphaned Serena/LSP processes  [--force]
  dashboard         Open live browser dashboard  [--no-open]
  service <sub>     Manage always-on dashboard daemon  (install|uninstall|start|stop|status)
  version           Show installed versions of the components
  update            Update components  [--fresh] [installer flags]
  uninstall         Remove all token-diet components  [--dry-run] [--force]
  --help            Show this help

COMPONENTS
  Serena   LSP symbol navigation        fewer prompt turns; not separately measured
  ICM      Persistent cross-tool memory recall replaces re-reading; not measured
  context7 Remote library-docs MCP      https://mcp.context7.com/mcp; optional
                                        CONTEXT7_API_KEY (never displayed)

INSTALL
  bash install.sh             Install all components
  bash install.sh --dry-run   Preview what would be installed

helpEOF
}

# --- Dispatch -----------------------------------------------------------------
# Only dispatch when executed directly. When sourced (e.g. by the characterization
# bats tests that call hosts_registered() against a planted $HOME), skip dispatch
# so callers can exercise individual functions in isolation.
if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
  return 0 2>/dev/null || true
fi

case "${1:-status}" in
  status|gain)       cmd_status ;;
  health)            cmd_health ;;
  doctor|verify)     shift; cmd_doctor "$@" ;;
  repair)            shift; cmd_repair "$@" ;;
  mcp)               shift; cmd_mcp "$@" ;;
  upstream)          shift; cmd_upstream "$@" ;;
  budget)            shift; cmd_budget "$@" ;;
  extract)           shift; cmd_extract "$@" ;;
  dashboard)         shift; cmd_dashboard "$@" ;;
  service)           shift; cmd_service "$@" ;;
  version|versions)  cmd_version ;;
  route)             shift; cmd_route "$@" ;;
  icm)               shift; cmd_icm "$@" ;;
  test-first)        shift; cmd_test_first "$@" ;;
  strip)             shift; cmd_strip "$@" ;;
  diff-reads)        shift; cmd_diff_reads "$@" ;;
  serena-status)     cmd_serena_status ;;
  serena-gc)         shift; cmd_serena_gc "$@" ;;
  update)            shift; cmd_update "$@" ;;
  reinstall)         echo "Warning: 'reinstall' is deprecated. Use 'token-diet update --fresh' instead."; shift; cmd_update --fresh "$@" ;;
  uninstall)         shift; cmd_uninstall "$@" ;;
  --help|-h|help)    cmd_help ;;
  --version)         echo "token-diet $TD_VERSION" ;;
  *)  echo "Unknown command: $1"; cmd_help; exit 1 ;;
esac
