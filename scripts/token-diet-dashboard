#!/usr/bin/env python3
"""token-diet-dashboard — live browser dashboard for the token-diet stack.
stdlib only. Starts a local HTTP server, optionally opens browser, Ctrl+C to stop.
"""
import datetime
import http.server
import json
import os
import pathlib
import subprocess
import sys
import threading
import webbrowser
import time
from urllib.parse import urlparse

PORT = 7384


def should_open_browser(argv=None):
    args = sys.argv[1:] if argv is None else list(argv)
    if any(arg in {"--no-open", "--no-browser"} for arg in args):
        return False
    value = os.environ.get("TOKEN_DIET_DASHBOARD_OPEN_BROWSER", "1").strip().lower()
    return value not in {"0", "false", "no", "off"}

# --- Memory Cache ------------------------------------------------------------
_CACHE = {"data": None, "expires": 0}
_CACHE_TTL = 30  # 30 seconds

def run(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None

def serena_stats():
    docker_image = run(["docker", "image", "inspect", "token-diet/serena:latest"], timeout=2) is not None
    uvx_version = run(["uvx", "--version"], timeout=2) is not None
    if not docker_image and not uvx_version: return None
    
    version = None
    if docker_image:
        version = run(["docker", "image", "inspect", "token-diet/serena:latest", "--format", '{{ index .Config.Labels "org.opencontainers.image.version" }}'], timeout=2)
    
    # Robust fallback: look for forks/serena/pyproject.toml in script path and CWD
    if not version or version == "<no value>":
        candidates = [
            pathlib.Path(__file__).parent.parent / "forks" / "serena" / "pyproject.toml",
            pathlib.Path.cwd() / "forks" / "serena" / "pyproject.toml",
        ]
        for pyp in candidates:
            if pyp.exists():
                try:
                    for line in pyp.read_text().splitlines():
                        if "version =" in line:
                            version = line.split("=")[1].strip().strip("\"").strip("'")
                            break
                    if version: break
                except: pass

    docker_running = False
    if docker_image:
        running_raw = run(["docker", "ps", "--filter", "ancestor=token-diet/serena:latest", "--format", "{{.ID}}"], timeout=2)
        docker_running = bool(running_raw)
    mem_dir = pathlib.Path.home() / ".serena" / "memories"
    log_dir = pathlib.Path.home() / ".serena" / "logs"
    memories  = len(list(mem_dir.iterdir())) if mem_dir.exists() else 0
    log_days  = len(list(log_dir.iterdir())) if log_dir.exists() else 0
    hosts     = _registered_hosts("serena")
    mode      = "docker-running" if docker_running else ("uvx" if uvx_version else "docker-image")
    return {"mode": mode, "version": version if version and version != "<no value>" else None, "hosts": hosts, "memories": memories, "log_days": log_days}

def icm_stats():
    ver = run(["icm", "--version"], timeout=2)
    if not ver: return None
    hosts = _registered_hosts("icm")
    return {"version": ver.split()[-1], "hosts": hosts}

def context7_stats():
    # Presence panel for the remote context7 MCP server. It has no local binary
    # or version to probe, so registration state (reusing the same MCP-host
    # registry reader as Serena/ICM) is the entire health signal.
    return {"url": "https://mcp.context7.com/mcp", "hosts": _registered_hosts("context7")}

def _get_last_project():
    # Previously resolved via the removed command-history database; the
    # project-config walk now starts at the dashboard's working directory.
    return pathlib.Path.cwd()

def _host_registry_path():
    """Locate the canonical MCP-host registry (config/hosts-mcp.json).

    Dev checkout: <repo>/config/hosts-mcp.json (relative to this script).
    Installed: $SCRIPT_DIR/../config/hosts-mcp.json → ~/.local/config/..., which
    install.sh copies alongside the binary. Strict Installation Decoupling means
    the installed dashboard must NOT read from the repo path — hence a per-
    location fallback rather than one hardcoded path.
    """
    candidates = [
        pathlib.Path(__file__).parent.parent / "config" / "hosts-mcp.json",
        pathlib.Path.cwd() / "config" / "hosts-mcp.json",
    ]
    for p in candidates:
        if p.exists():
            return p
    return candidates[0]


def _load_host_registry():
    """Read the canonical host registry. Loaded fresh (tiny file) so tests can
    repoint _host_registry_path without stale caching."""
    return json.loads(_host_registry_path().read_text())


def _registered_hosts(tool):
    reg = _load_host_registry()
    dialect = reg["mcp_key_dialect"]
    found = []
    home = pathlib.Path.home()
    for entry in reg["home_configs"]:
        path = home / entry["path"]
        if not path.exists(): continue
        try:
            content = path.read_text()
            if entry["format"] == "json":
                d = json.loads(content)
                servers = {}
                for key in dialect:
                    servers = d.get(key, {})
                    if servers: break
                if any(tool in k.lower() for k in servers): found.append(entry["host"])
            elif tool in content.lower():
                found.append(entry["host"])
        except: pass

    # Walk up from last project to find project-scoped config (e.g. VS Code).
    project_configs = reg.get("project_configs", [])
    if project_configs:
        curr = _get_last_project()
        while True:
            matched = False
            for entry in project_configs:
                p = curr / entry["path"]
                if p.exists() and tool in p.read_text().lower():
                    found.append(entry["host"])
                    matched = True
                    break
            if matched: break
            if curr == home or curr == curr.parent: break
            curr = curr.parent

    return list(dict.fromkeys(found))


def _missing_hosts(tool):
    reg = _load_host_registry()
    all_hosts = reg["all_hosts"]
    presence = reg["presence"]
    registered = _registered_hosts(tool)
    missing = [h for h in all_hosts if h not in registered]
    home = pathlib.Path.home()
    really_missing = []
    for m in missing:
        spec = presence.get(m)
        if not spec: continue
        base = home if spec.get("base", "home") == "home" else _get_last_project()
        if any((base / rel).exists() for rel in spec["paths"]):
            really_missing.append(m)
    return really_missing

def _read_budget_file(path):
    try: return json.loads(path.read_text())
    except: return None

def _budget_entry(cfg, file_path, is_active=False):
    warn = cfg.get("warn", 1500000); hard = cfg.get("hard", 0)
    # Usage used to come from the removed command counter; per-component savings
    # (Serena/ICM/context7) are structural and were never per-command countable,
    # so burn-down is no longer measurable. Thresholds stay readable.
    used = 0; unlimited = (hard == 0); pct = 0
    status = "ok"
    home_str = str(pathlib.Path.home())
    return {
        "warn": warn, "hard": hard, "used": used, "pct": pct, "status": status,
        "usage_tracked": False,
        "unlimited": unlimited,
        "installed_at": cfg.get("installed_at"),
        "file": str(file_path).replace(home_str, "~"),
        "is_active": is_active
    }

def budget_stats():
    home = pathlib.Path.home(); global_path = home / ".token-budget"
    project_path = None; d = _get_last_project()
    while True:
        p = d / ".token-budget"
        if p.exists(): project_path = p; break
        if d == home: break
        parent = d.parent
        if parent == d: break
        d = parent
    active_path = project_path if (project_path and project_path != global_path) else global_path
    if not active_path.exists(): return None
    cfg = _read_budget_file(active_path)
    if not cfg: return None
    return _budget_entry(cfg, active_path, is_active=True)

def all_budget_files(active_file=None):
    home = pathlib.Path.home()
    found = set()
    
    # 1. Load explicit Project Hubs from config
    config_path = home / ".config" / "token-diet" / "config.json"
    hubs = [home] # Always check home for global budget
    if config_path.exists():
        try:
            cfg = json.loads(config_path.read_text())
            for h in cfg.get("project_hubs", []):
                h_path = pathlib.Path(h).expanduser()
                if h_path.exists(): hubs.append(h_path)
        except: pass

    # 2. Targeted scan of Hubs (shallow)
    for hub in set(hubs):
        # Scan depth 2 (Hub itself + immediate children)
        try:
            # Check the hub itself
            b = hub / ".token-budget"
            if b.exists(): found.add(b)
            # Check children
            for child in hub.iterdir():
                if child.is_dir() and not child.name.startswith("."):
                    b = child / ".token-budget"
                    if b.exists(): found.add(b)
        except: pass

    # 3. Local context (always scan current + parent)
    curr = pathlib.Path.cwd()
    for p in [curr, curr.parent]:
        b = p / ".token-budget"
        if b.exists(): found.add(b)

    rows = []
    for p in sorted(list(found)):
        cfg = _read_budget_file(p)
        if cfg:
            is_active = (str(p) == active_file)
            rows.append(_budget_entry(cfg, p, is_active=is_active))
    return rows

def _get_version():
    ver_raw = run(["token-diet", "--version"])
    if ver_raw:
        return ver_raw.split()[-1]
    # Fallback: parse from sibling script file
    try:
        td_bin = pathlib.Path(__file__).parent / "token-diet"
        if td_bin.exists():
            for line in td_bin.read_text().splitlines()[:50]:
                if "TD_VERSION=" in line:
                    return line.split("=")[1].strip().strip("\"").strip("'")
    except: pass
    return "1.10.0"

# Tracked token-savings metrics were removed together with RTK (independent benchmarks found rtk gain did not reflect real cost); context7, Serena and ICM have no per-command counter, so the dashboard reports per-component presence and health instead of a combined spend figure.
def collect():
    now = time.time()
    if _CACHE["data"] and now < _CACHE["expires"]:
        return _CACHE["data"]

    budget = budget_stats()
    active_file = str(pathlib.Path.home() / budget["file"].replace("~/", "")) if budget else None

    data = {
        "version": _get_version(),
        "serena": serena_stats(),
        "icm": icm_stats(),
        "context7": context7_stats(),
        "budget": budget,
        "budgets": all_budget_files(active_file),
        "missing_hosts": {"serena": _missing_hosts("serena"), "icm": _missing_hosts("icm"), "context7": _missing_hosts("context7")},
        "cached_at": datetime.datetime.now().strftime("%H:%M:%S")
    }
    _CACHE["data"] = data
    _CACHE["expires"] = now + _CACHE_TTL
    return data

HTML = """<!doctype html><html lang=en><head><meta charset=utf-8>
