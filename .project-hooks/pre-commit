#!/usr/bin/env bash
# token-diet project pre-commit hook
# Run by ~/.githooks/pre-commit (global hook delegates here)
# ShipGuard SAST + secret detection are handled by the global hook — not here.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Verify install script is executable and passes a dry-run
echo "token-diet: verifying install.sh dry-run..."
bash "$REPO_ROOT/scripts/install.sh" --dry-run --skip-tests 2>&1 | tail -5

# --- Test selection -----------------------------------------------------------
# The full suite (261 bats + 67 pytest) takes ~10 minutes. CI runs all of it on
# every pull request and every push to main (.github/workflows/test.yml), so this
# hook only needs to cover what the staged change can break. Fail closed: any
# path the map below does not recognise runs the full suite. FULL_TESTS=1 forces
# the full suite on any commit.
staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"

docs_only=true
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.md|docs/*|LICENSE|LICENSE-*|compliance/*) ;;
    *) docs_only=false; break ;;
  esac
done <<< "$staged"

suites=""
run_pytest=false
if [ "${FULL_TESTS:-0}" = "1" ]; then
  suites="all"
  run_pytest=true
elif [ "$docs_only" = true ]; then
  echo "token-diet: docs-only change — skipping bats and pytest (FULL_TESTS=1 forces them)."
else
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      scripts/install.sh|scripts/uninstall.sh|scripts/token-diet-install.sh|scripts/*.ps1|lib/*|config/*|tests/install.bats)
        suites="$suites install hosts-registered" ;;
      scripts/token-diet|scripts/token-diet-dashboard|scripts/token-diet-mcp|tests/test_*.py|tests/token-diet.bats)
        suites="$suites token-diet"; run_pytest=true ;;
      scripts/build.sh|build.sh|scripts/release.sh|.github/workflows/*|docker/*|tests/build.bats)
        suites="$suites build" ;;
      .github/scripts/*|tests/path-leak.bats)
        suites="$suites path-leak" ;;
      *.md|docs/*|LICENSE|LICENSE-*|compliance/*|.gitignore|.gitattributes) ;;
      *) suites="all"; run_pytest=true ;;
    esac
  done <<< "$staged"
  # A changed code path that matched no rule must not run nothing.
  [ -n "$suites" ] || { suites="all"; run_pytest=true; }
fi

if [ "$suites" = "all" ]; then
  run_pytest=true
fi

if command -v bats &>/dev/null && [ -d "$REPO_ROOT/tests" ] && [ -n "$suites" ]; then
  if [ "$suites" = "all" ]; then
    echo "token-diet: running the full bats suite..."
    bats "$REPO_ROOT/tests/"*.bats
  else
    paths=""; seen=""
    for s in $suites; do
      case " $seen " in *" $s "*) continue ;; esac
      seen="$seen $s"
      paths="$paths $REPO_ROOT/tests/$s.bats"
    done
    echo "token-diet: running bats:$seen"
    # shellcheck disable=SC2086
    bats $paths
  fi
fi

# Run Python tests when a Python-facing file changed (or the full suite was asked for)
if [ "$run_pytest" = true ] && command -v python3 &>/dev/null && python3 -m pytest --version &>/dev/null 2>&1; then
  if [ -d "$REPO_ROOT/tests" ] && ls "$REPO_ROOT/tests"/test_*.py &>/dev/null 2>&1; then
    echo "token-diet: running pytest..."
    python3 -m pytest "$REPO_ROOT/tests/" -q
  fi
fi

# Run PowerShell tests if pwsh + Pester are available
if command -v pwsh &>/dev/null && pwsh -NoProfile -Command "Get-Module -ListAvailable Pester" &>/dev/null 2>&1; then
  if ls "$REPO_ROOT/tests/"*.Tests.ps1 &>/dev/null 2>&1; then
    # Skip slow PowerShell tests on non-Windows by default to save time
    if [[ "$(uname -s)" != "CYGWIN"* && "$(uname -s)" != "MINGW"* && "$(uname -s)" != "MSYS"* ]] && [ "${RUN_SLOW_TESTS:-0}" != "1" ]; then
      echo "token-diet: skipping slow Pester tests (set RUN_SLOW_TESTS=1 to run)."
    else
      echo "token-diet: running Pester tests..."
      pwsh -NoProfile -Command "
        \$env:USERPROFILE = if (\$env:USERPROFILE) { \$env:USERPROFILE } else { \$env:HOME }
        \$env:APPDATA     = if (\$env:APPDATA)     { \$env:APPDATA     } else { \$env:HOME }
        Import-Module Pester -Force
        \$cfg = New-PesterConfiguration
        \$cfg.Run.Path = '$REPO_ROOT/tests'
        \$cfg.Run.Exit = \$true
        \$cfg.Output.Verbosity = 'Minimal'
        Invoke-Pester -Configuration \$cfg
      "
    fi
  fi
fi

# Documentation Sync Check
# Ensure all primary subcommands are mentioned in README.md
echo "token-diet: verifying documentation sync..."
# Extract command names from help output
# The help's second section is COMPONENTS (renamed from TOOLS when the
# component set changed). The range end must match the current name: an
# unmatched end pattern makes sed run to EOF, capturing the component list
# and the usage examples as if they were undocumented subcommands.
COMMANDS=$(bash "$REPO_ROOT/scripts/token-diet" --help | sed -n '/COMMANDS/,/COMPONENTS/p' | grep '^  [a-z]' | awk '{print $1}')
MISSING=()
for CMD in $COMMANDS; do
  # Skip internal/redundant/low-level commands to avoid noise
  if [[ "$CMD" =~ ^(gain|service|upstream|version|update|serena-gc|strip)$ ]]; then continue; fi
  
  # Look for "token-diet <cmd>" in any code context or bold text
  if ! grep -qiE "(\`token-diet $CMD|token-diet $CMD\`|\*\*token-diet $CMD\*\*)" "$REPO_ROOT/README.md"; then
    MISSING+=("$CMD")
  fi
done

if [ ${#MISSING[@]} -ne 0 ]; then
  echo -e "\033[0;31m[BLOCKED] Documentation out of sync!\033[0m"
  echo "The following subcommands are in code but not documented in README.md:"
  for M in "${MISSING[@]}"; do echo "  - $M"; done
  echo -e "\nUpdate README.md before committing."
  exit 1
fi

echo "token-diet: pre-commit checks passed."
